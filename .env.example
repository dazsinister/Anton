# ─────────────────────────────────────────────────────────────
#  Anton settings. Copy this file to ".env" and fill it in.
#  ".env" is ignored by git, so your token never gets committed.
# ─────────────────────────────────────────────────────────────

# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# ── AI (/ask) ────────────────────────────────────────────────
# Get a key at https://console.anthropic.com → API Keys.
# Billed separately from a claude.ai subscription (pay as you go).
# Leave the placeholder in place and /ask simply says "AI isn't set up yet".
ANTHROPIC_API_KEY="HEY THIS IS WHERE YOUR KEY GOES!"
AI_MODEL=claude-sonnet-5-5
AI_MAX_SEARCHES=3            # web searches allowed per question
AI_USER_COOLDOWN_SEC=30      # seconds between questions per person
AI_DAILY_LIMIT_PER_USER=20   # questions per person per day
AI_DAILY_LIMIT=100           # questions for the whole server per day

# ── Feeds ────────────────────────────────────────────────────
# Each feed has a channel (or thread — thread wins if both are set),
# an interval in minutes, and whether to post brand-new listings.
# Channel, interval and on/off can also be changed live with /feed.
# A channel of 0 means the feed is off.

# InStockTrades Red Tag sale
CHANNEL_ID_REDTAG=0
THREAD_ID_REDTAG=0
RUN_INTERVAL_MIN_REDTAG=60
REDTAG_URL=https://www.instocktrades.com/specials/500/2025-red-tag-sale
REDTAG_POST_NEW=true

# InStockTrades Damages
CHANNEL_ID_DAMAGES=0
THREAD_ID_DAMAGES=0
RUN_INTERVAL_MIN_DAMAGES=60
DAMAGES_URL=https://www.instocktrades.com/damages
DAMAGES_POST_NEW=true

# InStockTrades publisher catalogs (big lists, so new listings are off by default;
# price drops, restocks and sell-outs are always posted)
CHANNEL_ID_MARVEL=0
THREAD_ID_MARVEL=0
RUN_INTERVAL_MIN_MARVEL=60
MARVEL_URL=https://www.instocktrades.com/publishers/marvel
MARVEL_POST_NEW=false

CHANNEL_ID_DC=0
THREAD_ID_DC=0
RUN_INTERVAL_MIN_DC=60
DC_URL=https://www.instocktrades.com/publishers/dc-comics
DC_POST_NEW=false

CHANNEL_ID_DARKHORSE=0
THREAD_ID_DARKHORSE=0
RUN_INTERVAL_MIN_DARKHORSE=60
DARKHORSE_URL=https://www.instocktrades.com/publishers/dark-horse-comics
DARKHORSE_POST_NEW=false

CHANNEL_ID_IMAGE=0
THREAD_ID_IMAGE=0
RUN_INTERVAL_MIN_IMAGE=60
IMAGE_URL=https://www.instocktrades.com/publishers/image-comics
IMAGE_POST_NEW=false

# Half Price Books omnibuses
CHANNEL_ID_HPB=0
THREAD_ID_HPB=0
RUN_INTERVAL_MIN_HPB=60
HPB_URL=https://www.hpb.com/books/trending-topics/omnibuses
HPB_POST_NEW=true

# Free games (Epic + GamerPower)
CHANNEL_ID_FREEGAMES=0
THREAD_ID_FREEGAMES=0
RUN_INTERVAL_MIN_FREEGAMES=60
FREEGAMES_POST_NEW=true

# ── Scraping politeness ──────────────────────────────────────
SCRAPE_PAGE_DELAY=0.8        # seconds between page requests
SCRAPE_MAX_PAGES=200
SCRAPE_TIMEOUT=25
SCRAPE_MAX_RUN_SECONDS=540
# InStockTrades is contacted as a plain bot (what the old scraper did, and what it accepts).
# If it starts answering "403 Forbidden", try IST_BROWSER_HEADERS=true, or paste your
# browser's Cookie header into IST_COOKIE together with that browser's User-Agent in IST_USER_AGENT.
IST_BROWSER_HEADERS=false
IST_USER_AGENT=
IST_COOKIE=
HPB_COOKIE=

# ── Posting ──────────────────────────────────────────────────
MAX_POSTS_PER_RUN=30         # beyond this, the rest is summarised in one line
POST_DELAY=1.0               # seconds between messages
FORUM_AUTOCREATE=false       # if a feed channel is a Forum, create a thread in it
FORUM_THREAD_TITLE=Anton Updates

# ── Logs / health ────────────────────────────────────────────
LOG_CHANNEL_ID=0             # health summaries go here (0 = don't send them)
HEALTH_MESSAGES=true

# ── Birthdays ────────────────────────────────────────────────
BDAY_CHANNEL_ID=0
BDAY_ANNOUNCE_HOUR=9
BDAY_TZ=America/New_York

# ── Development ──────────────────────────────────────────────
# Put your server ID here to make new slash commands appear instantly
# (global commands can take up to an hour the first time).
TEST_GUILD_ID=0
