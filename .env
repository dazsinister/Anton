# Red Tag target (either set CHANNEL or THREAD; if both set, THREAD wins)
CHANNEL_ID_REDTAG=1216468858974638210
THREAD_ID_REDTAG=0
RUN_INTERVAL_MIN_REDTAG=10

# Damages target
CHANNEL_ID_DAMAGES=1168498330502955108
THREAD_ID_DAMAGES=0
RUN_INTERVAL_MIN_DAMAGES=5

# Pacing / batching (optional)
POST_DELAY=0.25
BATCH_SIZE=50
BATCH_COOLDOWN=10.0

# If a CHANNEL_ID_* is a Forum channel, you can auto-create a thread:
FORUM_AUTOCREATE=true
FORUM_THREAD_TITLE=IST Updates

# Optional: fast guild sync while developing
# TEST_GUILD_ID=your_server_id
LOG_CHANNEL_ID=442444744464007190                 # if set, health messages go here
HEALTH_MESSAGES=true             # on/off (default true)
HEALTH_SUMMARY_PREFIX=[Health]   # optional prefix
